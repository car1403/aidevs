OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# compose.full-stack.yml이 PostgreSQL Container를 만들 때 사용하는 정보
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_db

# 기본 compose.yml의 Backend가 기존 공용 Container에 접속하는 주소
# Backend도 Container이므로 127.0.0.1 대신 host.docker.internal을 사용합니다.
DATABASE_URL=postgresql://agent_user:agent_password@host.docker.internal:5433/agent_db
REDIS_URL=redis://host.docker.internal:6379/0

# 선택형 Local LLM Container
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
GEMMA_MODEL=gemma

# Host Browser에서 접근하는 주소입니다. Frontend Container는 compose.yml에서
# http://backend:8000으로 Backend에 접근합니다.
API_BASE_URL=http://127.0.0.1:8000
