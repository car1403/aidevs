FROM python:3.12-slim
WORKDIR /course
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY shared ./shared
COPY 11_multi-agent-backend ./11_multi-agent-backend
ENV PYTHONPATH=/course
CMD ["uvicorn", "app.main:app", "--app-dir", "11_multi-agent-backend", "--host", "0.0.0.0", "--port", "8100"]
